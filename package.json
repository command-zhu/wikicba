{
  "name": "wikicba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "dev": "vite --host 0.0.0.0",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test:desktop": "electron test/electron-smoke.cjs",
    "format:check": "prettier --check electron src test package.json vite.config.js .github/workflows/validate.yml"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "local.wikicba.desktop",
    "productName": "WikiCBA",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
